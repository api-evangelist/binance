          "name": "Exchange information",
          "request": {
            "name": "Exchange information",
            "description": {
              "content": "Get current exchange trading rules and symbol information, including available trading pairs, price filters, lot size filters, and order type constraints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "exchangeInfo"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "symbol",
                  "value": "<string>",
                  "description": "Trading pair symbol, e.g. BTCUSDT."
                },
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "JSON array of trading pair symbols to query. Cannot be used with the symbol parameter."
                },
                {
                  "disabled": false,
                  "key": "permissions",
                  "value": "<string>",
                  "description": "Filter by account permissions such as SPOT or MARGIN."
                }
              ],
              "variable": []
