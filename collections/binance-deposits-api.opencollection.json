{
  "opencollection": "1.0.0",
  "info": {
    "name": "Binance Algo Trading Account Deposits API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-MBX-APIKEY",
      "value": "{{X-MBX-APIKEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Deposits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Deposit history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.binance.com/sapi/v1/capital/deposit/hisrec",
            "params": [
              {
                "name": "coin",
                "value": "",
                "type": "query",
                "description": "Coin to query."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Deposit status. 0=pending, 6=credited, 1=success."
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results. Default 1000, max 1000."
              },
              {
                "name": "recvWindow",
                "value": "",
                "type": "query"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query"
              },
              {
                "name": "signature",
                "value": "",
                "type": "query"
              },
              {
                "name": "txId",
                "value": "",
                "type": "query",
                "description": "Transaction ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-MBX-APIKEY",
              "value": "{{X-MBX-APIKEY}}",
              "placement": "header"
            }
          },
          "docs": "Fetch deposit history."
        },
        {
          "info": {
            "name": "Deposit address",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.binance.com/sapi/v1/capital/deposit/address",
            "params": [
              {
                "name": "coin",
                "value": "",
                "type": "query"
              },
              {
                "name": "network",
                "value": "",
                "type": "query"
              },
              {
                "name": "recvWindow",
                "value": "",
                "type": "query"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query"
              },
              {
                "name": "signature",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-MBX-APIKEY",
              "value": "{{X-MBX-APIKEY}}",
              "placement": "header"
            }
          },
          "docs": "Fetch deposit address for a coin and network."
        }
      ]
    }
  ],
  "bundled": true
}