{
  "opencollection": "1.0.0",
  "info": {
    "name": "Binance Algo Trading Account Borrow/Repay API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-MBX-APIKEY",
      "value": "{{X-MBX-APIKEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Borrow/Repay",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query borrow/repay records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.binance.com/sapi/v1/margin/borrow-repay",
            "params": [
              {
                "name": "asset",
                "value": "",
                "type": "query",
                "description": "Asset to query."
              },
              {
                "name": "isolatedSymbol",
                "value": "",
                "type": "query",
                "description": "Isolated margin symbol."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "BORROW or REPAY."
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "current",
                "value": "",
                "type": "query",
                "description": "Current page. Default 1."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size. Default 10, max 100."
              },
              {
                "name": "recvWindow",
                "value": "",
                "type": "query"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query"
              },
              {
                "name": "signature",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-MBX-APIKEY",
              "value": "{{X-MBX-APIKEY}}",
              "placement": "header"
            }
          },
          "docs": "Query margin borrow and repay records."
        }
      ]
    }
  ],
  "bundled": true
}