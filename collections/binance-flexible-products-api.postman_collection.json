    "_postman_id": "540e6030-9ac1-4b75-8bb2-21da2d247486",
    "name": "Binance Algo Trading Account Flexible Products API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Binance Algo Trading API provides access to algorithmic order execution strategies such as TWAP (Time-Weighted Average Price) and volume participation algorithms. Developers can place large orders that are automatically broken into smaller child orders and executed over time to minimize market impact.\n\nContact Support:\n Name: Binance Support",
      "type": "text/plain"
    }
  }
