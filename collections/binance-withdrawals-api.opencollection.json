{
  "opencollection": "1.0.0",
  "info": {
    "name": "Binance Algo Trading Account Withdrawals API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-MBX-APIKEY",
      "value": "{{X-MBX-APIKEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Withdrawals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Withdraw",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.binance.com/sapi/v1/capital/withdraw/apply",
            "params": [
              {
                "name": "coin",
                "value": "",
                "type": "query"
              },
              {
                "name": "withdrawOrderId",
                "value": "",
                "type": "query",
                "description": "Client ID for withdraw."
              },
              {
                "name": "network",
                "value": "",
                "type": "query"
              },
              {
                "name": "address",
                "value": "",
                "type": "query"
              },
              {
                "name": "addressTag",
                "value": "",
                "type": "query"
              },
              {
                "name": "amount",
                "value": "",
                "type": "query"
              },
              {
                "name": "transactionFeeFlag",
                "value": "",
                "type": "query",
                "description": "When true, the fee will be deducted from the amount."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Address label."
              },
              {
                "name": "walletType",
                "value": "",
                "type": "query",
                "description": "0 for spot wallet, 1 for funding wallet."
              },
              {
                "name": "recvWindow",
                "value": "",
                "type": "query"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query"
              },
              {
                "name": "signature",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-MBX-APIKEY",
              "value": "{{X-MBX-APIKEY}}",
              "placement": "header"
            }
          },
          "docs": "Submit a withdrawal request."
        },
        {
          "info": {
            "name": "Withdraw history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.binance.com/sapi/v1/capital/withdraw/history",
            "params": [
              {
                "name": "coin",
                "value": "",
                "type": "query"
              },
              {
                "name": "withdrawOrderId",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "0=email sent, 1=cancelled, 2=awaiting approval, 3=rejected, 4=processing, 5=failure, 6=completed."
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "recvWindow",
                "value": "",
                "type": "query"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query"
              },
              {
                "name": "signature",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-MBX-APIKEY",
              "value": "{{X-MBX-APIKEY}}",
              "placement": "header"
            }
          },
          "docs": "Fetch withdrawal history."
        }
      ]
    }
  ],
  "bundled": true
}